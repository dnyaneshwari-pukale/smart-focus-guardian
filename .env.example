# Smart Focus Guardian - Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_focus_guardian

# Security & CORS
CORS_ORIGIN=*
# Device Authentication Secret (Must match device_token in firmware)
DEVICE_SECRET_TOKEN=sfg_device_secret_2026

# Hardware Polling & Status Thresholds
DEVICE_OFFLINE_TIMEOUT_SEC=30
LDR_AUTO_THRESHOLD=35
