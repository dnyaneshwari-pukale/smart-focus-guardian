    "simulate:device": "node backend/utils/deviceSimulator.js"
  },
  "keywords": [
    "iot",
    "esp8266",
    "pomodoro",
    "study-lamp",
    "pir-sensor",
    "ldr",
    "express",
    "mysql"
  ],
