{
  "name": "smart-focus-guardian",
  "version": "1.0.0",
  "description": "Smart Focus Guardian - IoT-based smart study lamp and focus assistant with NodeMCU ESP8266, PIR, LDR, and MySQL backend",
  "main": "backend/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "test": "node --test backend/tests/api.test.js",
