    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "mysql2": "^3.10.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
